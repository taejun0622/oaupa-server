# Application
ENVIRONMENT=dev
APP_NAME=oaupa
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://oaupa:oaupa@localhost:5432/oaupa

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
OAUPA_MASTER_KEY=  # 32-byte base64-encoded key. Generate with: python scripts/generate_encryption_key.py
JWT_SECRET_KEY=    # Random secret for JWT signing
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth
OAUTH_CALLBACK_BASE_URL=http://localhost:8000/api/v1/oauth/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SES
SES_REGION=us-east-1
SES_FROM_EMAIL=  # Verified SES sender address (e.g. noreply@yourdomain.com)

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_METHODS=["GET","POST","PATCH","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
